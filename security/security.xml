<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_otm_cw" model="res.groups.privilege">
        <field name="name">Car Wash</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>

    <record id="group_cw_operator" model="res.groups">
        <field name="name">Bay Operator</field>
        <field name="privilege_id" ref="privilege_otm_cw"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cw_reception" model="res.groups">
        <field name="name">Reception</field>
        <field name="privilege_id" ref="privilege_otm_cw"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_cw_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_otm_cw"/>
        <field name="implied_ids" eval="[(4, ref('group_cw_reception')), (4, ref('group_cw_operator'))]"/>
    </record>
</odoo>
