<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_cw_package_expiry" model="ir.cron">
        <field name="name">Car Wash: package expiry notifications</field>
        <field name="model_id" ref="model_otm_cw_subscription"/>
        <field name="state">code</field>
        <field name="code">model.cron_package_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_cw_notifications" model="ir.cron">
        <field name="name">Car Wash: send queued customer notifications</field>
        <field name="model_id" ref="model_otm_cw_notification"/>
        <field name="state">code</field>
        <field name="code">model.cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
